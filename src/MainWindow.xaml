<Window x:Class="BeeHealth.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BeeHealth" Width="1150" Height="700"
 MinWidth="900" MinHeight="550" Background="#F7F3E8" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DrawingImage x:Key="Bee">
   <DrawingImage.Drawing>
    <DrawingGroup>
     <GeometryDrawing Brush="#DAE8DA" Geometry="M37,31 C16,30 12,12 28,10 C40,8 50,21 50,35 Z"/>
     <GeometryDrawing Brush="#E9F1E4" Geometry="M47,32 C46,13 57,5 67,11 C80,19 63,32 54,36 Z"/>
     <GeometryDrawing Brush="#EEB541" Geometry="M79,46 C79,59 64,70 47,70 C30,70 15,60 15,46 C15,33 30,25 46,25 C64,25 79,33 79,46 Z"/>
     <GeometryDrawing Brush="#273329" Geometry="M38,26 C33,38 34,55 42,69 L33,67 C26,57 24,41 29,29 Z M55,26 C49,39 50,56 59,68 L49,70 C41,59 40,40 46,25 Z M70,35 C88,31 99,43 93,56 C89,66 75,67 69,59 C63,53 63,43 70,35 Z M15,43 L5,47 16,52 Z"/>
     <GeometryDrawing Brush="#273329" Geometry="M74,38 Q75,27 82,24 L84,27 Q78,30 78,38 Z M83,37 Q87,28 95,29 L95,32 Q89,31 86,39 Z"/>
     <GeometryDrawing Brush="#FFF7DA" Geometry="M88,45 A2,2 0 1 1 84,45 A2,2 0 1 1 88,45"/>
    </DrawingGroup>
   </DrawingImage.Drawing>
  </DrawingImage>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#FFFDF8"/><Setter Property="Foreground" Value="#26372C"/>
   <Setter Property="BorderBrush" Value="#D6CEBA"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#896111"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#896111"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#E8EEDD"/><Setter Property="Foreground" Value="#283B2C"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="11,8"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="10,4"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DataGridCell">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#F9E3A2"/><Setter Property="Foreground" Value="#273329"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="AlternatingRowBackground" Value="#F8F5ED"/><Setter Property="Background" Value="White"/>
   <Setter Property="RowHeight" Value="40"/><Setter Property="ColumnWidth" Value="Auto"/>
  </Style>
 </Window.Resources>
 <Grid><Grid x:Name="Workspace" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Background="#21372B">
   <StackPanel DockPanel.Dock="Top" Margin="22,26,15,26">
    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource Bee}" Width="35" Height="30" Margin="0,0,7,0"/><TextBlock Text="BeeHealth" FontSize="27" FontWeight="Bold" Foreground="#FFDC81"/></StackPanel>
    <TextBlock Text="Учёт пчелиных семей" Foreground="#E9E7DC" Margin="0,5,0,0"/>
   </StackPanel>
   <ListBox x:Name="Navigation" BorderThickness="0" Padding="10,0" Background="Transparent"
            SelectionChanged="Navigate">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
       <Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,2">
         <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
         <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#BDD0BF"/>
         <Setter TargetName="ItemSurface" Property="BorderThickness" Value="1"/>
        </Trigger></ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True">
       <Setter Property="Foreground" Value="#253024"/><Setter Property="Background" Value="#F9CA69"/>
      </Trigger></Style.Triggers>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
  </DockPanel>
  <DockPanel Grid.Column="1" Margin="30">
   <StackPanel DockPanel.Dock="Top">
    <DockPanel><Image DockPanel.Dock="Right" Source="{StaticResource Bee}" Width="52" Height="42" Opacity="0.85"/><TextBlock x:Name="Heading" FontSize="34" FontWeight="SemiBold" Foreground="#283226"/></DockPanel>
    <TextBlock x:Name="Hint" Foreground="#555C4F" Margin="0,4,0,16" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
     <TextBox x:Name="SearchBox" Width="205" Padding="6" MaxLength="120" Margin="0,0,8,0" ToolTip="Поиск по тексту" KeyDown="SearchKey"/>
     <StackPanel x:Name="Period" Orientation="Horizontal">
      <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <DatePicker x:Name="FromDate" Width="120" Margin="0,0,8,0" DateValidationError="BadDate"/>
      <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <DatePicker x:Name="ToDate" Width="120" Margin="0,0,8,0" DateValidationError="BadDate"/>
     </StackPanel>
     <Button Content="Применить" Click="Apply"/><Button Content="Сбросить" Click="Reset"/>
    </WrapPanel>
    <WrapPanel x:Name="Actions" Margin="0,0,0,12">
     <Button Content="Добавить" Background="#F6C760" Click="Add"/>
     <Button x:Name="EditButton" Content="Изменить" Click="Edit"/>
     <Button Content="Удалить" Click="Delete"/>
    </WrapPanel>
   </StackPanel>
   <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#414C3E"/>
   <Border Background="White" BorderBrush="#DACFBA" BorderThickness="1" CornerRadius="10" Padding="7"><Grid><DataGrid x:Name="Records" BorderThickness="0" AutoGeneratingColumn="FormatColumn" MouseDoubleClick="OpenRecord"/><TabControl x:Name="Report" Visibility="Collapsed"/></Grid></Border>
  </DockPanel>
 </Grid>
 <Grid x:Name="Welcome" Background="#21372B">
  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="510" Padding="38,30"
          CornerRadius="24" Background="#FFF9E9" BorderBrush="#DDB55E" BorderThickness="1">
   <StackPanel>
    <Image Source="{StaticResource Bee}" Width="112" Height="85" HorizontalAlignment="Center"/>
    <TextBlock Text="BeeHealth" FontSize="19" FontWeight="SemiBold" Foreground="#6D521C" HorizontalAlignment="Center"/>
    <TextBlock Text="Уважаете ли вы пчёлок?" FontSize="31" FontWeight="Bold" Foreground="#21372B"
               TextAlignment="Center" Margin="0,10,0,20"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button Content="Да" MinWidth="110" Background="#F6C760" Click="AcceptBees" IsDefault="True"/>
     <Button Content="Нет" MinWidth="110" Click="DeclineBees"/>
    </StackPanel>
    <Border x:Name="LocationPanel" Visibility="Collapsed" Background="#F3E8CC" CornerRadius="10"
            Padding="16,12" Margin="0,18,0,0">
     <StackPanel>
      <TextBlock Text="Местоположение по настройкам Windows" FontWeight="SemiBold" Foreground="#21372B"/>
      <TextBlock x:Name="LocationText" TextWrapping="Wrap" Foreground="#374B3B" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</Window>
